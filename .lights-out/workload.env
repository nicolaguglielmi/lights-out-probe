# .lights-out/workload.env, drafted by ./go init on 2026-11-08 at 511984f (docs/adr/0042 §6):
# the twelve keys the platform reads (docs/adr/0030 §2, 0042 §1, 0053 §1), each under
# a comment saying where its value comes from. KEY=VALUE, one per line, no
# inline comments, no `$` or `#` in a value. Paths are relative to the
# repository's root. Edit, then copy .lights-out/ into your repository and
# commit it: lights-out never writes there.

# Provenance, default: empty, the plane half is not drafted (docs/adr/0042 §7); fill in to run the plane
CANARY_VERSION=

# Provenance, default: empty, the plane half is not drafted (docs/adr/0042 §7); fill in to run the plane
WORKLOAD_KILL_SWITCH=

# Provenance, default: empty, the plane half is not drafted (docs/adr/0042 §7); fill in to run the plane
WORKLOAD_SAMPLE_PATH=

# Provenance, measurement: measured by ./go init on 2026-11-08 at 511984f, in workbench: sh .lights-out/runners/mutation.sh textkit "uv run --locked pytest tests -q -x -p no:cacheprovider" with MUTATION_LINES=all, 3 mutants, 3 killed, 7s wall time. Re-measure with ./go mutation-baseline when the suite or the tool changes.
MUTATION_BASELINE=1.0

# Provenance, inferred: uv.lock at the root
WORKLOAD_LOCKFILES=uv.lock

# Provenance, inferred: [project].name = 'textkit' and textkit/__init__.py exists
WORKLOAD_MUTATION_SCOPE=textkit/

# Provenance, inferred: the package sits at the repository root, nothing to strip
WORKLOAD_TEST_ROOT=

# Provenance, default: pytest's default python_files (test_*.py, *_test.py) anywhere, plus its conftest.py (docs/adr/0053 §1)
WORKLOAD_TEST_PATHS=test_*.py:*/test_*.py:*_test.py:conftest.py:*/conftest.py

# Provenance, inferred: requires-python = '>=3.13' admits the workbench's python3 3.13; set an image to run elsewhere
TOOLCHAIN_IMAGE=workbench

# Provenance, inferred: tests/ exists; pytest through uv, the lock honoured
TEST_CMD=uv run --locked pytest tests -q -p no:cacheprovider

# Provenance, default: bandit over the package, the stack's runner (stacks/python/runners/sast.sh)
SAST_CMD=sh .lights-out/runners/sast.sh textkit

# Provenance, default: cosmic-ray over the package, the stack's runner (stacks/python/runners/mutation.sh), the suite stopped at its first failure per mutant
MUTATION_CMD=sh .lights-out/runners/mutation.sh textkit "uv run --locked pytest tests -q -x -p no:cacheprovider"
